# PII Anonymizer — configuration template.
# Copy to .env and fill in. No secret below has a fallback value in the source:
# leave one unset and the feature it belongs to fails closed.

# ── Secrets (required) ───────────────────────────────────────────────

# AES-256 key for encrypting placeholder→original mappings at rest.
# Rotating this makes previously stored mappings undecryptable.
# Generate: openssl rand -hex 32
PII_ENCRYPTION_KEY=

# Signing key for /api/v2 access tokens.
# If unset, an ephemeral key is generated per process and an error is logged —
# tokens then stop working across restarts.
# Generate: openssl rand -hex 32
PII_JWT_SECRET=

# Shared key for the legacy X-API-Key path on /api/v2/* (grants admin).
# Leave EMPTY to keep that path disabled — there is no built-in fallback key.
# Generate: openssl rand -hex 32
PII_API_KEY=

# ── Database ─────────────────────────────────────────────────────────
# Dedicated Postgres for the mapping store, isolated from application data.
# Without it the service falls back to an in-memory TTL cache.

PII_DB_HOST=localhost
PII_DB_PORT=5432
PII_DB_NAME=pii_anonymizer
PII_DB_USER=pii_user
PII_DB_PASSWORD=

# ── Detection ────────────────────────────────────────────────────────

# False = regex + name dictionary only (~1 ms, the production default).
# True  = additionally run the local Qwen2.5-3B GGUF pass (slower, catches
#         free-form names and addresses). Requires llama-cpp-python, which is
#         not in requirements.txt — see the note at the top of that file.
PII_USE_LLM=False
PII_MODEL_PATH=/opt/models/qwen2.5-3b-instruct-q4_k_m.gguf
PII_N_THREADS=14
PII_N_CTX=2048

# ── Server ───────────────────────────────────────────────────────────

PII_HOST=0.0.0.0
PII_PORT=8100
PII_LOG_LEVEL=INFO

# Mapping TTL in the in-memory cache (seconds) and its cap.
PII_MAPPING_TTL=3600
PII_MAX_CACHE_SIZE=10000

# ── Basic auth for the web UI (optional) ─────────────────────────────
# Both must be set for the Basic-auth path to accept anything.
PII_WEB_USERNAME=
PII_WEB_PASSWORD=
